{
  "name": "card-trades",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n client,server -c cyan,magenta \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "vite",
    "dev:server": "tsx watch --env-file=.env server/src/index.ts",
    "build": "tsc -b && vite build && tsc -p server/tsconfig.json",
    "start": "node --env-file=.env dist-server/server/src/index.js",
    "db:migrate": "tsx --env-file=.env server/src/db/migrate.ts",
    "db:generate": "drizzle-kit generate --config server/drizzle.config.ts",
    "preview": "vite preview",
    "lint": "oxlint"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.4",
    "@node-rs/argon2": "^2.0.2",
    "drizzle-orm": "^0.44.5",
    "hono": "^4.9.6",
    "nodemailer": "^9.1.0",
    "postgres": "^3.4.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.31.4",
    "oxlint": "^1.79.0",
    "tsx": "^4.20.5",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  }
}
