NODE_ENV=development
PORT=3000
# Локально (npm run dev): localhost:5432. В Docker Compose DATABASE_URL задаётся сам.
DATABASE_URL=postgresql://cardtrades:cardtrades@localhost:5432/cardtrades
SESSION_SECRET=change-me-to-a-random-string-at-least-32-chars
# Dev (Vite): http://localhost:5173 | Docker/prod: http://localhost:3000 или публичный URL
APP_URL=http://localhost:5173
ALLOW_REGISTRATION=true
TRUST_PROXY=false
COOKIE_SECURE=false

# Email (optional in dev — links are logged to server console)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@card-trades.local
